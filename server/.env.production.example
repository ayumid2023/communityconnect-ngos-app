# Server Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-domain.com

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/communityconnect

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_secret_key
JWT_EXPIRE=7d

# Stripe Payment
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CommunityConnect <noreply@communityconnect.org>

# Sentry Error Tracking
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx@sentry.io/123456

# GitHub App
GITHUB_APP_ID=your_app_id
GITHUB_APP_CLIENT_ID=your_client_id
GITHUB_APP_CLIENT_SECRET=your_client_secret
GITHUB_INSTALLATION_ID=your_installation_id

# Logging
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
